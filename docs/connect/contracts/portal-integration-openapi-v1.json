{
  "openapi": "3.1.0",
  "info": {"title": "Robotronix EdTech Portal Integration", "version": "1.0.0", "description": "Proposed contract only. Not a deployed API. Scoped per Connect tenant and linked Portal institution."},
  "servers": [{"url": "https://{portalHost}/api/integrations/connect", "variables": {"portalHost": {"default": "portal.example.invalid"}}}],
  "security": [{"IntegrationBearer": []}],
  "paths": {
    "/v1/demo-capabilities": {"get": {"operationId": "getDemoCapabilities", "tags": ["Demo"], "responses": {"200": {"$ref": "#/components/responses/Success"}, "403": {"$ref": "#/components/responses/Error"}}}},
    "/v1/demo-availability": {"get": {"operationId": "getDemoAvailability", "tags": ["Demo"], "parameters": [{"name": "programmeRef", "in": "query", "required": true, "schema": {"type": "string"}}, {"name": "startDate", "in": "query", "required": true, "schema": {"type": "string", "format": "date"}}, {"name": "timezone", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"$ref": "#/components/responses/Success"}, "403": {"$ref": "#/components/responses/Error"}}}},
    "/v1/demo-bookings": {"post": {"operationId": "createDemoBooking", "tags": ["Demo"], "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/Booking"}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "202": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/v1/demo-bookings/{bookingId}/reschedule": {"post": {"operationId": "rescheduleDemoBooking", "tags": ["Demo"], "parameters": [{"$ref": "#/components/parameters/BookingId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/Reschedule"}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/v1/demo-bookings/{bookingId}/cancel": {"post": {"operationId": "cancelDemoBooking", "tags": ["Demo"], "parameters": [{"$ref": "#/components/parameters/BookingId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/Cancel"}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/v1/enrollment-handoffs": {"post": {"operationId": "createEnrollmentHandoff", "tags": ["Enrollment"], "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/Handoff"}, "responses": {"200": {"$ref": "#/components/responses/Success"}, "202": {"$ref": "#/components/responses/Success"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/v1/customer-lifecycle/{linkId}": {"get": {"operationId": "getCustomerLifecycle", "tags": ["Lifecycle"], "parameters": [{"name": "linkId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"$ref": "#/components/responses/Success"}, "403": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "securitySchemes": {"IntegrationBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque scoped integration credential"}},
    "parameters": {
      "BookingId": {"name": "bookingId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 12, "maxLength": 128}}
    },
    "schemas": {
      "Learner": {"type": "object", "additionalProperties": false, "required": ["displayName", "gradeOrAgeBand", "interest"], "properties": {"displayName": {"type": "string", "minLength": 1, "maxLength": 120}, "gradeOrAgeBand": {"type": "string", "maxLength": 60}, "interest": {"type": "string", "maxLength": 120}, "preparationNotes": {"type": "string", "maxLength": 1000}}},
      "Booking": {"type": "object", "additionalProperties": false, "required": ["requestId", "externalOpportunityId", "programmeRef", "trainerId", "slotStart", "durationMinutes", "timezone", "learner", "guardianConsentRef"], "properties": {"requestId": {"type": "string", "format": "uuid"}, "externalOpportunityId": {"type": "string", "format": "uuid"}, "programmeRef": {"type": "string"}, "trainerId": {"type": "string", "format": "uuid"}, "slotStart": {"type": "string", "format": "date-time"}, "durationMinutes": {"type": "integer", "minimum": 15, "maximum": 180}, "timezone": {"type": "string"}, "learner": {"$ref": "#/components/schemas/Learner"}, "guardianConsentRef": {"type": "string"}}},
      "Reschedule": {"type": "object", "required": ["requestId", "expectedVersion", "trainerId", "slotStart", "durationMinutes", "timezone"], "properties": {"requestId": {"type": "string", "format": "uuid"}, "expectedVersion": {"type": "integer", "minimum": 1}, "trainerId": {"type": "string", "format": "uuid"}, "slotStart": {"type": "string", "format": "date-time"}, "durationMinutes": {"type": "integer", "minimum": 15}, "timezone": {"type": "string"}}},
      "Cancel": {"type": "object", "required": ["requestId", "expectedVersion", "reason"], "properties": {"requestId": {"type": "string", "format": "uuid"}, "expectedVersion": {"type": "integer", "minimum": 1}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}}},
      "Handoff": {"type": "object", "required": ["requestId", "externalOpportunityId", "verifiedPersonLinks", "acceptedOfferSnapshot", "programmeRef", "guardianConsentRef"], "properties": {"requestId": {"type": "string", "format": "uuid"}, "externalOpportunityId": {"type": "string", "format": "uuid"}, "verifiedPersonLinks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "portalPersonId", "crmPersonId"], "properties": {"role": {"enum": ["guardian", "learner"]}, "portalPersonId": {"type": "string", "format": "uuid"}, "crmPersonId": {"type": "string", "format": "uuid"}}}}, "acceptedOfferSnapshot": {"type": "object", "required": ["currency", "amount", "termsVersion"], "properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}, "termsVersion": {"type": "string"}}}, "programmeRef": {"type": "string"}, "guardianConsentRef": {"type": "string"}}},
      "Error": {"type": "object", "required": ["ok", "error", "correlationId"], "properties": {"ok": {"const": false}, "error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}, "correlationId": {"type": "string"}}}
    },
    "requestBodies": {
      "Booking": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Booking"}}}},
      "Reschedule": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Reschedule"}}}},
      "Cancel": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Cancel"}}}},
      "Handoff": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Handoff"}}}}
    },
    "responses": {
      "Success": {"description": "Authoritative confirmed or pending result", "content": {"application/json": {"schema": {"type": "object", "required": ["ok", "data", "correlationId"], "properties": {"ok": {"const": true}, "data": {"type": "object"}, "correlationId": {"type": "string"}}}}}},
      "Error": {"description": "Permission, validation, conflict or retryable failure", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}
