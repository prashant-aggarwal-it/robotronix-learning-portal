# LOCAL DEMO MODE: leave Supabase values blank and keep NEXT_PUBLIC_APP_ENV=local.
# LIVE LOCAL MODE: copy this file to .env.local and fill the browser-safe values.
# PRODUCTION: set NEXT_PUBLIC_APP_ENV=production and ALL required values in Netlify.
# Production intentionally refuses to render if the public Supabase values are missing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# SERVER ONLY — required for admin portal invitations and the scheduled reminder worker.
# Never prefix these with NEXT_PUBLIC_ and never expose the service-role key to browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local automated QA only. Keep real passwords in .env.local; never commit them.
QA_ADMIN_EMAIL=qa-admin@robotronix.local
QA_ADMIN_PASSWORD=
QA_TRAINER_EMAIL=qa-trainer@robotronix.local
QA_TRAINER_PASSWORD=
QA_PARENT_EMAIL=qa-parent@robotronix.local
QA_PARENT_PASSWORD=
QA_STUDENT_EMAIL=qa-student@robotronix.local
QA_STUDENT_PASSWORD=
QA_BASE_URL=http://localhost:3000
