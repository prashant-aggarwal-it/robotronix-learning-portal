# Robotronix Learning Portal + Connect CRM — environment template
# Copy to .env.local for local Development/QA. Never commit .env.local.
# Use DEVELOPMENT Supabase keys locally; never copy production secrets into this template.
# Both applications use the same Supabase Auth project. Connect data lives in its separate connect schema.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local
# Optional customer-delight CTA. Use the direct Google 'Write a review' link.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/CY2m6TlvKlmoEBM/review

# SERVER ONLY
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — use TEST keys for QA; Live keys only in production host environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Automated QA users
QA_ADMIN_EMAIL=qa-admin@robotronix.local
QA_ADMIN_PASSWORD=
QA_TRAINER_EMAIL=qa-trainer@robotronix.local
QA_TRAINER_PASSWORD=
QA_PARENT_EMAIL=qa-parent@robotronix.local
QA_PARENT_PASSWORD=
QA_STUDENT_EMAIL=qa-student@robotronix.local
QA_STUDENT_PASSWORD=
QA_BASE_URL=http://localhost:3000

# Optional Razorpay Test Mode write/webhook checks. NEVER enable with Live credentials.
QA_RAZORPAY_WRITE=0
QA_RAZORPAY_WEBHOOK_INVOICE_ID=

# Optional location API override
# COUNTRIES_NOW_API_BASE=https://countriesnow.space/api/v0.1/countries

# Zoom Classroom POC — SERVER ONLY. Do not expose these as NEXT_PUBLIC_ variables.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://portal.robotronixstemlab.com/api/zoom/oauth/callback
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZOOM_TOKEN_ENCRYPTION_KEY=
# Optional separate random secret for OAuth state signing. If blank, Client Secret is used during POC.
ZOOM_OAUTH_STATE_SECRET=

# ============================================================
# CONNECT CRM — OPTIONAL EXTERNAL INTEGRATIONS (SERVER ONLY)
# ============================================================
# The core CRM uses the Supabase variables above; no second
# Supabase project or Connect-specific database credentials are needed.

# Public website enquiry intake. Disabled by default until origin and
# bot protection have been reviewed. Do not enable for untrusted origins.
CONNECT_PUBLIC_FORMS_ENABLED=false
CONNECT_FORM_ALLOWED_ORIGINS=
CONNECT_TURNSTILE_SECRET=

# Meta WhatsApp Cloud API and Meta Lead Ads webhooks.
# Verify token is user-defined; app secret and access token come from Meta.
CONNECT_META_VERIFY_TOKEN=
CONNECT_META_APP_SECRET=
CONNECT_META_GRAPH_ACCESS_TOKEN=
# Optional Graph API version override; leave empty for code default.
CONNECT_META_GRAPH_VERSION=

# Resend inbound email webhook (whsec_... signing secret).
CONNECT_RESEND_WEBHOOK_SECRET=

# Scheduled follow-up/reminder job authentication.
# Use a long random secret; do not expose to the browser.
CONNECT_REMINDER_JOB_SECRET=
