# Copy to .env.sanity.local ONLY while running controlled post-deploy production sanity.
# Never commit real passwords or Supabase service-role keys.
QA_TARGET=production
QA_BASE_URL=https://portal.robotronixstemlab.com
QA_NO_WEBSERVER=1

SANITY_ADMIN_EMAIL=prod-sanity-admin@robotronix.local
SANITY_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_TEMP_PASSWORD
SANITY_TRAINER_EMAIL=prod-sanity-trainer@robotronix.local
SANITY_TRAINER_PASSWORD=CHANGE_TO_A_STRONG_TEMP_PASSWORD
SANITY_PARENT_EMAIL=prod-sanity-parent@robotronix.local
SANITY_PARENT_PASSWORD=CHANGE_TO_A_STRONG_TEMP_PASSWORD
SANITY_STUDENT_EMAIL=prod-sanity-student@robotronix.local
SANITY_STUDENT_PASSWORD=CHANGE_TO_A_STRONG_TEMP_PASSWORD

SANITY_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
SANITY_SUPABASE_ANON_KEY=YOUR_PRODUCTION_ANON_KEY
SANITY_SUPABASE_SERVICE_ROLE_KEY=YOUR_PRODUCTION_SERVICE_ROLE_KEY
