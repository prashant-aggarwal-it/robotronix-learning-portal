{
  "name": "robotronix-learning-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:structure": "node scripts/check-structure.mjs",
    "check:communication": "node scripts/check-communication-security.mjs",
    "check:finance": "node --experimental-strip-types scripts/check-student-finance.mjs",
    "check:production-env": "node scripts/check-production-env.mjs",
    "check:release": "npm run typecheck && npm run check:structure && npm run check:communication && npm run check:finance && npm run check:migration && npm run check:fresh-db && npm run check:zoom-poc && npm run check:zoom-classroom && npm run check:razorpay-ops && npm run check:exports && npm run check:customer-delight && npm run check:calendar",
    "qa:auth-check": "playwright test qa/auth.setup.ts --project=auth-setup",
    "qa:roles": "playwright test qa/admin.spec.ts qa/roles.spec.ts qa/permissions.spec.ts --project=desktop-chromium",
    "qa:workflow": "playwright test qa/workflows.spec.ts --project=desktop-chromium",
    "qa:release": "playwright test --project=desktop-chromium",
    "qa:report": "playwright show-report",
    "qa:create-users": "node scripts/create-qa-auth-users.mjs",
    "qa:delete-users": "node scripts/delete-qa-auth-users.mjs",
    "qa:production-readiness": "playwright test qa/production-readiness.spec.ts --project=desktop-chromium",
    "qa:razorpay": "playwright test qa/razorpay.spec.ts --project=desktop-chromium",
    "qa:mobile-smoke": "playwright test qa/public.spec.ts qa/production-readiness.spec.ts --project=mobile-chromium --grep \"public homepage|login is role-neutral\"",
    "qa:prod-gate": "npm run check:release && npm run qa:auth-check && npm run qa:roles && npm run qa:workflow && npm run qa:risk-lifecycles && npm run qa:payroll-rules && npm run qa:production-readiness && npm run qa:razorpay && npm run qa:mobile",
    "qa:payroll-rules": "playwright test qa/payroll-rules.spec.ts --project=desktop-chromium",
    "qa:mobile": "playwright test qa/mobile-responsive.spec.ts --project=mobile-chromium",
    "qa:scheduling-lifecycle": "playwright test qa/scheduling-lifecycle.spec.ts --project=desktop-chromium",
    "qa:attendance-exceptions": "playwright test qa/attendance-exceptions.spec.ts --project=desktop-chromium",
    "qa:finance-lifecycle": "playwright test qa/finance-lifecycle.spec.ts --project=desktop-chromium",
    "qa:communications-negative": "playwright test qa/communications-negative.spec.ts --project=desktop-chromium",
    "qa:risk-lifecycles": "npm run qa:scheduling-lifecycle && npm run qa:attendance-exceptions && npm run qa:finance-lifecycle && npm run qa:communications-negative && npm run qa:active-student-migration && npm run qa:pre-go-live",
    "check:migration": "node scripts/check-active-student-migration.mjs",
    "qa:active-student-migration": "playwright test qa/active-student-migration.spec.ts --project=desktop-chromium",
    "check:zoom-poc": "node scripts/check-zoom-poc.mjs",
    "check:zoom-classroom": "node scripts/check-zoom-classroom-v1.mjs",
    "check:razorpay-ops": "node scripts/check-razorpay-ops.mjs",
    "check:exports": "node scripts/check-operational-exports.mjs",
    "check:customer-delight": "node scripts/check-customer-delight.mjs",
    "check:calendar": "node scripts/check-calendar-experience.mjs",
    "check:fresh-db": "node scripts/check-fresh-db-release.mjs",
    "qa:pre-go-live": "playwright test qa/pre-go-live-features.spec.ts --project=desktop-chromium",
    "sanity:create-users": "node scripts/create-prod-sanity-auth-users.mjs",
    "sanity:delete-users": "node scripts/delete-prod-sanity-auth-users.mjs",
    "qa:prod-sanity": "npm run check:prod-sanity-env && npm run qa:auth-check && npm run qa:roles && npm run qa:workflow && npm run qa:active-student-migration && npm run qa:pre-go-live && npm run qa:communications-negative",
    "check:prod-sanity-env": "node scripts/check-prod-sanity-env.mjs",
    "qa:dev-cycle": "npm run qa:prod-gate",
    "check:deployment": "npm run check:release && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "@playwright/test": "^1.55.0"
  }
}
