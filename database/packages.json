{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Robotronix canonical clean-install packages. Each package generates one sequential SQL installer from authoritative Portal, Tasks, CRM and optional integration sources.",
  "status": "static-validation-only-not-clean-install-certified",
  "sharedPrerequisite": "Supabase Auth and service_role; no Portal public tables required by CRM/Tasks core",
  "packages": {
    "tasks-only": [
      "canonical/00_preflight.sql",
      "canonical/02_tasks_schema.sql",
      "canonical/04_tasks_functions.sql",
      "canonical/06_tasks_security.sql",
      "canonical/08_verify_tasks.sql"
    ],
    "crm-only": [
      "canonical/00_preflight.sql",
      "canonical/03_crm_schema.sql",
      "canonical/05_crm_functions.sql",
      "canonical/07_crm_security.sql",
      "canonical/09_verify_crm.sql"
    ],
    "crm-tasks": [
      "canonical/00_preflight.sql",
      "canonical/02_tasks_schema.sql",
      "canonical/03_crm_schema.sql",
      "canonical/04_tasks_functions.sql",
      "canonical/05_crm_functions.sql",
      "canonical/06_tasks_security.sql",
      "canonical/07_crm_security.sql",
      "integrations/02_tasks_crm.sql",
      "integrations/03_tasks_crm_links.sql",
      "canonical/08_verify_tasks.sql",
      "canonical/09_verify_crm.sql"
    ],
    "portal-only": [
      "canonical/01_portal_manifest.json",
      "03_verify/01_VERIFY_RELEASE.sql"
    ],
    "portal-crm": [
      "canonical/01_portal_manifest.json",
      "canonical/03_crm_schema.sql",
      "canonical/05_crm_functions.sql",
      "canonical/07_crm_security.sql",
      "integrations/01_crm_portal.sql",
      "canonical/09_verify_crm.sql"
    ],
    "portal-tasks": [
      "canonical/01_portal_manifest.json",
      "canonical/02_tasks_schema.sql",
      "canonical/04_tasks_functions.sql",
      "canonical/06_tasks_security.sql",
      "integrations/04_tasks_portal_notifications.sql",
      "integrations/06_tasks_portal_links.sql",
      "canonical/08_verify_tasks.sql"
    ],
    "full-suite": [
      "canonical/01_portal_manifest.json",
      "canonical/02_tasks_schema.sql",
      "canonical/03_crm_schema.sql",
      "canonical/04_tasks_functions.sql",
      "canonical/05_crm_functions.sql",
      "canonical/06_tasks_security.sql",
      "canonical/07_crm_security.sql",
      "integrations/01_crm_portal.sql",
      "integrations/02_tasks_crm.sql",
      "integrations/04_tasks_portal_notifications.sql",
      "integrations/05_full_suite_task_links.sql",
      "canonical/08_verify_tasks.sql",
      "canonical/09_verify_crm.sql"
    ]
  },
  "rules": {
    "optionalIntegrationModules": [
      "01_crm_portal.sql",
      "02_tasks_crm.sql",
      "03_tasks_crm_links.sql",
      "04_tasks_portal_notifications.sql",
      "05_full_suite_task_links.sql",
      "06_tasks_portal_links.sql"
    ],
    "exclusiveGroups": [
      [
        "integrations/03_tasks_crm_links.sql",
        "integrations/05_full_suite_task_links.sql",
        "integrations/06_tasks_portal_links.sql"
      ]
    ],
    "productionExecutionAllowed": false,
    "portalManifest": "canonical/01_portal_manifest.json"
  },
  "generatedOutputs": {
    "tasks-only": "generated/ROBOTRONIX_TASKS_FRESH_INSTALL.sql",
    "crm-only": "generated/ROBOTRONIX_CRM_FRESH_INSTALL.sql",
    "crm-tasks": "generated/ROBOTRONIX_CRM_TASKS_FRESH_INSTALL.sql",
    "portal-only": "generated/ROBOTRONIX_FRESH_INSTALL.sql",
    "portal-crm": "generated/ROBOTRONIX_PORTAL_CRM_FRESH_INSTALL.sql",
    "portal-tasks": "generated/ROBOTRONIX_PORTAL_TASKS_FRESH_INSTALL.sql",
    "full-suite": "generated/ROBOTRONIX_FULL_SUITE_FRESH_INSTALL.sql"
  }
}
