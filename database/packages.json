{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Robotronix canonical clean-install packages. Each package generates one sequential SQL installer from authoritative Portal, Tasks, CRM and optional integration sources.",
  "status": "static-validation-only-not-clean-install-certified",
  "sharedPrerequisite": "Supabase Auth and service_role; no Portal public tables required by CRM/Tasks core",
  "packages": {
    "tasks-only": [
      "shared/preflight.sql",
      "tasks/01_schema.sql",
      "tasks/02_functions.sql",
      "tasks/03_security.sql",
      "tasks/04_verify.sql"
    ],
    "crm-only": [
      "shared/preflight.sql",
      "crm/01_schema.sql",
      "crm/02_functions.sql",
      "crm/03_security.sql",
      "crm/04_verify.sql"
    ],
    "crm-tasks": [
      "shared/preflight.sql",
      "tasks/01_schema.sql",
      "tasks/02_functions.sql",
      "tasks/03_security.sql",
      "crm/01_schema.sql",
      "crm/02_functions.sql",
      "crm/03_security.sql",
      "shared/integrations/02_tasks_crm.sql",
      "shared/integrations/03_tasks_crm_links.sql",
      "tasks/04_verify.sql",
      "crm/04_verify.sql"
    ],
    "portal-only": [
      "portal/manifest.json",
      "portal/verify.sql"
    ],
    "portal-crm": [
      "portal/manifest.json",
      "crm/01_schema.sql",
      "crm/02_functions.sql",
      "crm/03_security.sql",
      "shared/integrations/01_crm_portal.sql",
      "crm/04_verify.sql"
    ],
    "portal-tasks": [
      "portal/manifest.json",
      "tasks/01_schema.sql",
      "tasks/02_functions.sql",
      "tasks/03_security.sql",
      "shared/integrations/04_tasks_portal_notifications.sql",
      "shared/integrations/06_tasks_portal_links.sql",
      "tasks/04_verify.sql"
    ],
    "full-suite": [
      "portal/manifest.json",
      "tasks/01_schema.sql",
      "tasks/02_functions.sql",
      "tasks/03_security.sql",
      "crm/01_schema.sql",
      "crm/02_functions.sql",
      "crm/03_security.sql",
      "shared/integrations/01_crm_portal.sql",
      "shared/integrations/02_tasks_crm.sql",
      "shared/integrations/04_tasks_portal_notifications.sql",
      "shared/integrations/05_full_suite_task_links.sql",
      "tasks/04_verify.sql",
      "crm/04_verify.sql"
    ]
  },
  "rules": {
    "optionalIntegrationModules": [
      "01_crm_portal.sql",
      "02_tasks_crm.sql",
      "03_tasks_crm_links.sql",
      "04_tasks_portal_notifications.sql",
      "05_full_suite_task_links.sql",
      "06_tasks_portal_links.sql"
    ],
    "exclusiveGroups": [
      [
        "shared/integrations/03_tasks_crm_links.sql",
        "shared/integrations/05_full_suite_task_links.sql",
        "shared/integrations/06_tasks_portal_links.sql"
      ]
    ],
    "productionExecutionAllowed": false,
    "portalManifest": "portal/manifest.json"
  },
  "generatedOutputs": {
    "tasks-only": "generated/ROBOTRONIX_TASKS_FRESH_INSTALL.sql",
    "crm-only": "generated/ROBOTRONIX_CRM_FRESH_INSTALL.sql",
    "crm-tasks": "generated/ROBOTRONIX_CRM_TASKS_FRESH_INSTALL.sql",
    "portal-only": "generated/ROBOTRONIX_FRESH_INSTALL.sql",
    "portal-crm": "generated/ROBOTRONIX_PORTAL_CRM_FRESH_INSTALL.sql",
    "portal-tasks": "generated/ROBOTRONIX_PORTAL_TASKS_FRESH_INSTALL.sql",
    "full-suite": "generated/ROBOTRONIX_FULL_SUITE_FRESH_INSTALL.sql"
  }
}
